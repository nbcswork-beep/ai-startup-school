{
  "name": "ai-startup-school-telegram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "qa:mobile": "node scripts/capture-mobile.mjs",
    "qa:teacher": "node scripts/capture-teacher.mjs",
    "qa:admin": "node scripts/capture-admin.mjs",
    "auth:hash-password": "tsx scripts/hash-password.mjs",
    "auth:bootstrap-web": "tsx scripts/bootstrap-web-auth.mjs",
    "bot:set-webhook": "node scripts/set-telegram-webhook.mjs",
    "runtime:export": "tsx scripts/runtime-state.mjs",
    "runtime:restore": "tsx scripts/runtime-state.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server-dist/server/index.js",
    "bot": "tsx bot/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@vercel/blob": "^2.8.1",
    "docx": "9.7.2",
    "dotenv": "^16.4.7",
    "exceljs": "4.4.0",
    "fastify": "^5.12.5",
    "grammy": "^1.35.0",
    "jose": "^6.2.12",
    "js-tiktoken": "^1.0.21",
    "mammoth": "1.13.0",
    "marked": "18.0.12",
    "pdfmake": "0.3.11",
    "pg": "^8.23.0",
    "pptxgenjs": "4.0.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "fengari": "^0.1.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
