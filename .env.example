BOT_TOKEN=
MINI_APP_URL=https://your-mini-app.example
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# 0 = Sunday; hour is interpreted in Europe/Kyiv.
PARENT_WEEKLY_REPORT_DAY=0
PARENT_WEEKLY_REPORT_HOUR_KYIV=19

# Student API. Production must use persistent ES256 keys; PostgreSQL is the durable target backend.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_BACKEND=memory
DATABASE_URL=
DATABASE_SSL=true
TELEGRAM_BOT_TOKEN=
# Server-only JSON map. Fill only after each validated Telegram user ID is known.
# Example keys: illia, ivan, rinat, yuliia
TELEGRAM_STUDENT_BINDINGS_JSON=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
APP_JWT_ISSUER=ai-startup-school
APP_JWT_AUDIENCE=authenticated
APP_JWT_KEY_ID=aiss-development
APP_JWT_PRIVATE_KEY_BASE64=
APP_JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
# Server-only JSON array: [{"userId":"...","email":"...","passwordHash":"scrypt$..."}]
WEB_AUTH_ACCOUNTS_JSON=
# Upstash Redis REST credentials for durable Vercel sessions and distributed login throttling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel custom-prefix integration aliases are also auto-detected:
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
SESSION_REDIS_PREFIX=aiss:local:sessions:v1
DEV_AUTH_ENABLED=true
DEV_EPHEMERAL_JWT=true
DEV_USER_ID=10000000-0000-4000-8000-000000000001
AI_PROVIDER=mock
WORKSPACE_URL=
TRUST_PROXY=false
STORAGE_PRIVATE_BUCKETS_CONFIGURED=false
ADMIN_MFA_CONFIGURED=false
SECURITY_MONITORING_CONFIGURED=false
