BOT_TOKEN=
MINI_APP_URL=https://your-mini-app.example
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# 0 = Sunday; hour is interpreted in Europe/Kyiv.
PARENT_WEEKLY_REPORT_DAY=0
PARENT_WEEKLY_REPORT_HOUR_KYIV=19

# Student API. Production must use persistent ES256 keys; PostgreSQL is the durable target backend.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_BACKEND=memory
DATABASE_URL=
DATABASE_SSL=true
TELEGRAM_BOT_TOKEN=
# Server-only JSON map. Fill only after each validated Telegram user ID is known.
# Example keys: illia, ivan, rinat, yuliia
TELEGRAM_STUDENT_BINDINGS_JSON=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
APP_JWT_ISSUER=ai-startup-school
APP_JWT_AUDIENCE=authenticated
APP_JWT_KEY_ID=aiss-development
APP_JWT_PRIVATE_KEY_BASE64=
APP_JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
# Server-only JSON array: [{"userId":"...","email":"...","passwordHash":"scrypt$..."}]
WEB_AUTH_ACCOUNTS_JSON=
# Upstash Redis REST credentials for durable Vercel sessions and distributed login throttling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel custom-prefix integration aliases are also auto-detected:
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
# Scope this PER ENVIRONMENT in Vercel, never "All Environments".
# Production must contain a production/prod/live segment; Preview must not. A deployment whose
# prefix breaks that rule fails closed at boot, so Preview can never write into Production data.
SESSION_REDIS_PREFIX=aiss:local:sessions:v1
# Optional. Defaults to "<SESSION_REDIS_PREFIX>:pilot-runtime:v1"; set it only to move the state key.
PILOT_RUNTIME_REDIS_PREFIX=
# Production refuses to seed demo data over a missing runtime state key. Set this to true for a
# single deploy only when intentionally starting a brand new school.
ALLOW_RUNTIME_STATE_BOOTSTRAP=false
DEV_AUTH_ENABLED=true
DEV_EPHEMERAL_JWT=true
DEV_USER_ID=10000000-0000-4000-8000-000000000001
# AI assistant (docs/AI-ASSISTANT.md). Provider keys are entered in Admin OS, never here.
# 32 random bytes as base64; encrypts provider keys at rest. Falls back to a key derived from SESSION_TOKEN_PEPPER.
AI_SECRETS_KEY=
# Optional Redis namespace for balances and chats; defaults to SESSION_REDIS_PREFIX + ":ai:v1".
AI_REDIS_PREFIX=
WORKSPACE_URL=
TRUST_PROXY=false
STORAGE_PRIVATE_BUCKETS_CONFIGURED=false
# Homework attachments (docs/HOMEWORK-FILES.md). On Vercel, connecting a private Blob store adds
# BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN; without them uploads are reported as unavailable.
# Locally, files are kept in LOCAL_UPLOAD_DIR.
HOMEWORK_UPLOAD_MAX_FILE_MB=20
HOMEWORK_UPLOAD_MAX_FILES=10
HOMEWORK_UPLOAD_MAX_TOTAL_MB=50
FILE_STORAGE_PREFIX=
LOCAL_UPLOAD_DIR=.data/homework-uploads
ADMIN_MFA_CONFIGURED=false
SECURITY_MONITORING_CONFIGURED=false

# Optional Cloud Run dispatcher; leave blank locally. See docs/CLOUD-RUN-WORKER.md.
# Current Google provider trusts assl Production only. Do not set these for Preview.
# No service-account JSON key or manually stored VERCEL_OIDC_TOKEN is used.
AI_WORKER_GCP_PROJECT=
AI_WORKER_GCP_REGION=
AI_WORKER_JOB_NAME=
# Google provider resource (NOT the Vercel JWT's team URL audience):
# //iam.googleapis.com/projects/752806759634/locations/global/workloadIdentityPools/vercel/providers/vercel-oidc
AI_WORKER_WIF_AUDIENCE=
AI_WORKER_DISPATCH_SERVICE_ACCOUNT=
# Independent executions (one task each); configure the same value in Vercel and Cloud Run.
AI_WORKER_MAX_CONCURRENT=15
# Secret shared with the worker, at least 32 characters. Never commit a real value.
AI_WORKER_CALLBACK_SECRET=
# New 32-byte base64 key for worker copies; do not replace the current Vercel AI_SECRETS_KEY.
AI_SECRETS_KEY_NEXT=
